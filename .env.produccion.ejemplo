# =====================================================================
#  EXPLORA RD — Configuración para la página PUBLICADA (producción)
#  1. En el servidor, copia este archivo con el nombre .env
#  2. Cambia todo lo que dice CAMBIAR
#  3. Ejecuta: php artisan key:generate   (crea la clave secreta APP_KEY)
#  NUNCA subas el archivo .env a GitHub ni lo compartas: tiene contraseñas.
# =====================================================================

APP_NAME="Explora RD"
APP_ENV=production
APP_KEY=
# false = los visitantes NO ven los detalles técnicos de los errores (muy importante)
APP_DEBUG=false
APP_URL=https://CAMBIAR-tu-dominio.com
APP_TIMEZONE=America/Santo_Domingo

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Solo se anotan los errores (no todo lo que pasa)
LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# Base de datos MySQL que te da el hosting
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=CAMBIAR_nombre_de_la_base
DB_USERNAME=CAMBIAR_usuario
DB_PASSWORD=CAMBIAR_contrasena_segura

# Sesiones: la cookie solo viaja por HTTPS (candado)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Correo de verdad (para avisos de reservas y «¿Olvidaste tu contraseña?»).
# Los datos los da el hosting o un servicio de correo (SMTP).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CAMBIAR_smtp.tu-hosting.com
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR_no-responder@tu-dominio.com
MAIL_PASSWORD=CAMBIAR_contrasena_del_correo
MAIL_FROM_ADDRESS="no-responder@CAMBIAR-tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# Contacto general de Explora RD (sale en la página y en el botón de WhatsApp)
EXPLORA_WHATSAPP=CAMBIAR_1809XXXXXXX
EXPLORA_CORREO=CAMBIAR_info@tu-dominio.com
EXPLORA_TELEFONO=CAMBIAR_809-XXX-XXXX
EXPLORA_DIRECCION="Santo Domingo, República Dominicana"
